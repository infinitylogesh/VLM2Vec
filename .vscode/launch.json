{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train: Qwen3.5 2B smoke test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "TOKENIZERS_PARALLELISM": "false",
                "WANDB_DISABLED": "true"
            },
            "args": [
                "--model_name",
                "Qwen/Qwen3.5-2b",
                "--processor_name",
                "Qwen/Qwen3.5-2b",
                "--model_type",
                "qwen3_5",
                "--pooling",
                "eos",
                "--normalize",
                "True",
                "--temperature",
                "0.02",
                "--lora",
                "--lora_r",
                "8",
                "--lora_alpha",
                "16",
                "--dataset_config",
                "${workspaceFolder}/experiments/public/train/train_image_debug_minimal.yaml",
                "--data_basedir",
                "${workspaceFolder}/data",
                "--max_len",
                "2048",
                "--resize_min_pixels",
                "3136",
                "--resize_max_pixels",
                "200704",
                "--output_dir",
                "${workspaceFolder}/outputs/debug/qwen3_5_2b",
                "--run_name",
                "debug-qwen3.5-2b",
                "--project_name",
                "vlm2vec-debug",
                "--bf16",
                "True",
                "--per_device_train_batch_size",
                "1",
                "--gradient_accumulation_steps",
                "1",
                "--dataloader_num_workers",
                "0",
                "--max_steps",
                "1",
                "--logging_steps",
                "1",
                "--save_strategy",
                "no",
                "--remove_unused_columns",
                "False",
                "--report_to",
                "none",
                "--resume_from",
                "none"
            ]
        }
    ]
}
